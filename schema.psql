CREATE OR REPLACE FUNCTION update_modified_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = now();
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TABLE IF NOT EXISTS tenants (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  url TEXT UNIQUE NOT NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_tenants_modtime 
BEFORE UPDATE ON tenants 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_tenants_url ON tenants(url);

CREATE TABLE IF NOT EXISTS packages (
  id SERIAL PRIMARY KEY,
  tenant_id INT REFERENCES tenants(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  description TEXT,
  price INT DEFAULT 0,
  discount INT DEFAULT 0,
  image TEXT,
  image_id TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_packages_modtime 
BEFORE UPDATE ON packages 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_packages_tenant_id ON packages(tenant_id);
CREATE INDEX idx_packages_slug ON packages(slug);
CREATE TABLE IF NOT EXISTS package_features (
  id SERIAL PRIMARY KEY,
  package_id INT REFERENCES packages(id) ON DELETE CASCADE,
  feature_id INT REFERENCES features(id) ON DELETE CASCADE,
  value BOOLEAN DEFAULT TRUE,
  UNIQUE(package_id, feature_id)
);
CREATE INDEX idx_package_features_package_id ON package_features(package_id);
CREATE INDEX idx_package_features_feature_id ON package_features(feature_id);
CREATE TABLE IF NOT EXISTS user_cart (
  id SERIAL PRIMARY KEY,
  user_id INT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
  package_id INT NOT NULL REFERENCES packages(id) ON DELETE CASCADE,
  created_at TIMESTAMP DEFAULT now(),
  UNIQUE(user_id, package_id)
);
CREATE INDEX idx_user_cart_user_id ON user_cart(user_id);
CREATE INDEX idx_user_cart_package_id ON user_cart(package_id);

CREATE TABLE IF NOT EXISTS supports (
  id SERIAL PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT NOT NULL,
  subject TEXT NOT NULL,
  description TEXT NOT NULL,
  reply TEXT,                 
  status TEXT DEFAULT 'pending' CHECK(status IN ('pending', 'replied')),
  responded_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_supports_modtime 
BEFORE UPDATE ON supports 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_supports_email ON supports(email);
CREATE INDEX idx_supports_status ON supports(status);
CREATE INDEX idx_supports_responded_by ON supports(responded_by);

CREATE TABLE IF NOT EXISTS reviews (
  id SERIAL PRIMARY KEY,
  user_id INT REFERENCES users(id) ON DELETE CASCADE UNIQUE,
  tenant_name TEXT,
  rating INT CHECK (rating BETWEEN 1 AND 5),
  comment TEXT,
  reply TEXT,
  is_approved BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_reviews_user_id ON reviews(user_id);
CREATE INDEX idx_reviews_is_approved ON reviews(is_approved);

CREATE TABLE IF NOT EXISTS news_letters (
  id SERIAL PRIMARY KEY,
  subject TEXT NOT NULL,
  description TEXT,
  image TEXT NOT NULL,
  image_id TEXT NOT NULL,
  created_by INT REFERENCES staffs(id) ON DELETE CASCADE,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_news_letters_modtime 
BEFORE UPDATE ON news_letters 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_news_letters_created_by ON news_letters(created_by);

CREATE TABLE IF NOT EXISTS blogs (
  id SERIAL PRIMARY KEY,
  title TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  description TEXT,
  image TEXT,
  image_id TEXT,
  tenant_id INT NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
  created_by INT REFERENCES staffs(id) ON DELETE SET NULL,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_blogs_modtime 
BEFORE UPDATE ON blogs 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_blogs_slug ON blogs(slug);
CREATE INDEX idx_blogs_tenant_id ON blogs(tenant_id);
CREATE INDEX idx_blogs_created_by ON blogs(created_by);


CREATE TABLE IF NOT EXISTS themes (
  id SERIAL PRIMARY KEY,
  tenant_id INT REFERENCES tenants(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  slug TEXT UNIQUE NOT NULL,
  link TEXT,
  description TEXT,
  created_at TIMESTAMP DEFAULT now(),
  updated_at TIMESTAMP DEFAULT now()
);
CREATE TRIGGER update_themes_modtime 
BEFORE UPDATE ON themes 
FOR EACH ROW EXECUTE PROCEDURE update_modified_column();
CREATE INDEX idx_themes_tenant_id ON themes(tenant_id);
CREATE INDEX idx_themes_slug ON themes(slug);

CREATE TABLE IF NOT EXISTS themes_images (
  id SERIAL PRIMARY KEY,
  theme_id INT NOT NULL REFERENCES themes(id) ON DELETE CASCADE,
  image TEXT NOT NULL,
  image_id TEXT,
  description TEXT,
  created_at TIMESTAMP DEFAULT now()
);
CREATE INDEX idx_themes_images_theme_id ON themes_images(theme_id);
